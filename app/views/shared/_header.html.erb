<header>
  <nav class="navbar md:navbar-expand bg-1 border-bottom">
    <div class="container-fluid">
      <%= link_to "🎧 Банк звукових ефектів", root_path, class: "navbar-brand" %>

      <button class="btn-icon navbar-toggler" type="button" data-bs-toggle="drawer" data-bs-target="#navbarDrawer"
              aria-controls="navbarDrawer" aria-expanded="false" aria-label="Відкрити меню">
        <span class="navbar-toggler-icon" aria-hidden="true"></span>
      </button>

      <dialog class="drawer drawer-end" tabindex="-1" id="navbarDrawer" aria-labelledby="navbarDrawerLabel">
        <div class="drawer-header">
          <h5 class="drawer-title" id="navbarDrawerLabel">Меню</h5>
          <button type="button" class="btn-close" data-bs-dismiss="drawer" aria-label="Закрити"></button>
        </div>

        <div class="drawer-body mb-2 md:mb-0">
          <ul class="nav navbar-nav me-auto">
            <li class="nav-item">
              <%= link_to "Про проєкт", about_path, class: "nav-link" %>
            </li>

            <li class="nav-item">
              <%= link_to "Всі звуки", sound_effects_path, class: "nav-link" %>
            </li>

            <li class="nav-item">
              <%= link_to "Додати звук", new_sound_effect_path, class: "nav-link" %>
            </li>

            <%# Nav tab за категоріями звуків (варіант 29) %>
            <li class="nav-item">
              <button class="nav-link" type="button" data-bs-toggle="menu" data-bs-strategy="fixed" aria-expanded="false">
                Категорії
              </button>
              <div class="menu">
                <% SoundEffect::CATEGORIES.each do |cat| %>
                  <%= link_to cat, sound_effects_path(category: cat), class: "menu-item" %>
                <% end %>
                <hr class="menu-divider">
                <%= link_to "Усі категорії", sound_effects_path, class: "menu-item" %>
              </div>
            </li>

            <li class="nav-item">
              <%= button_to "Видалити всі", destroy_all_sound_effects_path,
                            method: :delete,
                            class: "nav-link fg-danger",
                            form: { data: { turbo_confirm: "Точно видалити ВСІ звукові ефекти?" } } %>
            </li>
          </ul>

          <div class="hstack gap-2">
            <span class="navbar-text">Прослухати:</span>
            <audio controls preload="none" src="/sounds/preview.mp3"></audio>
          </div>
        </div>
      </dialog>
    </div>
  </nav>
</header>
